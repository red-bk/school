// Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Change "postgresql" to "mysql" / "sqlite" / "sqlserver" if needed
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SheetUpload {
  id          String   @id @default(cuid())
  teacherId   String
  teacherName String
  sheetType   String
  fileName    String
  fileUrl     String
  fileKey     String   // the S3 object key, useful for deleting/updating later
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
